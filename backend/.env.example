# TrafficVision AI — Backend environment configuration
# Copy this file to backend/.env and fill in real values. NEVER commit .env.

# ── Required ────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (users, alerts, password reset tokens)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# JWT signing secret shared by the Express gateway AND the FastAPI service.
# Generate one with:  openssl rand -hex 32
JWT_SECRET_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Where password-reset links point to (the React app)
FRONTEND_URL=http://localhost:2000

# Express gateway port (default 2001)
# PORT=2001

# Python FastAPI AI engine URL used by the prediction proxy (default below)
# AI_ENGINE_URL=http://127.0.0.1:8000

# SMTP settings for real password-reset emails. If unset, reset links are
# printed to the server console instead (development mode).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM="TrafficVision AI <no-reply@trafficvision.ai>"

# Set to 'production' to make missing secrets a hard startup error
# NODE_ENV=production
