# Required — Neon Postgres connection string (free tier: https://neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required — any long random string, used to sign login sessions
JWT_SECRET_KEY=replace-with-a-long-random-string

# Required in production — the deployed frontend's URL. Used to build
# password-reset email links and (when NODE_ENV=production) to restrict CORS.
FRONTEND_URL=https://your-app.vercel.app

# Set this in production so CORS actually gets restricted to FRONTEND_URL.
NODE_ENV=production

# Optional — real emails for password reset. Without these, reset links are
# just printed to the server log (fine for a demo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional — real live-traffic routing/ETA. Without this, the app falls back
# to OSRM + a peak-hour heuristic.
TOMTOM_API_KEY=

# Optional — URL of the Python FastAPI ML engine, if you deploy it separately.
# Without it (or if unreachable), forecasts fall back gracefully.
AI_ENGINE_URL=http://127.0.0.1:8000
